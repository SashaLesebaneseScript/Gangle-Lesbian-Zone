-- ---------- AIMLOCK ----------
local function GetClosest()
    local closest, dist = nil, math.huge
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("Humanoid")
        and plr.Character.Humanoid.Health > 0 then
            local part = plr.Character:FindFirstChild(G.Aim.TargetPart)
            if part and LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
                local _, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    local d = (LP.Character.HumanoidRootPart.Position - part.Position).Magnitude
                    if d < dist then dist = d; closest = plr end
                end
            end
        end
    end
    return closest
end

RSvc.RenderStepped:Connect(function()
    if not G.Aim.Enabled then
        if Camera.CameraType == Enum.CameraType.Scriptable then
            Camera.CameraType = Enum.CameraType.Custom
        end
        return
    end

    if LP.Character and LP.Character:FindFirstChild("HumanoidRootPart") then
        Camera.CameraType = Enum.CameraType.Scriptable

        local tgt = G.Aim.Current
        if not tgt or not tgt.Character
        or not tgt.Character:FindFirstChild(G.Aim.TargetPart)
        or tgt.Character.Humanoid.Health <= 0 then
            tgt = GetClosest()
            G.Aim.Current = tgt
        end

        if tgt and tgt.Character then
            local part = tgt.Character:FindFirstChild(G.Aim.TargetPart)
            if part then
                local goal = CFrame.new(Camera.CFrame.Position, part.Position)
                Camera.CFrame = G.Aim.Humanize and Camera.CFrame:Lerp(goal, 0.2) or goal
            end
        end
    end
end)

-- ---------- FULLBRIGHT ----------
function G.ApplyLighting()
    if G.Visual.Fullbright then
        Lighting.Brightness = 2
        Lighting.ClockTime = 14
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
        Lighting.OutdoorAmbient = Color3.fromRGB(128,128,128)
    else
        Lighting.Brightness = G.OrigLighting.Brightness
        Lighting.ClockTime = G.OrigLighting.ClockTime
        Lighting.GlobalShadows = G.OrigLighting.GlobalShadows
        Lighting.FogEnd = G.OrigLighting.FogEnd
        Lighting.OutdoorAmbient = G.OrigLighting.OutdoorAmbient
    end
end

